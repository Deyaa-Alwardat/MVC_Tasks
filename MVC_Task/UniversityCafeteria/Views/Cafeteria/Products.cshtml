@{
    ViewData["Title"] = "Products";
    string[] products = { " Water", " Orange", "Juice", "Coffee", "Sandwich", "Chocolate", "Pizza" };
    string newProduct = "Pizza";
    string category = "";

    switch (newProduct)
    {
        case "Water":
        case "Orange Juice":
            category = "Drinks";
            break;

        case "Coffee":
            category = "Hot Drinks";
            break;

        case "Sandwich":
        case "Pizza":
            category = "Food";
            break;

        case "Chocolate":
            category = "Sweets";
            break;

        default:
            category = "Other";
            break;
    }
}
<link rel="stylesheet" href="~/css/products.css" />
<h1>Products Management</h1>

<p>Welcome to the cafeteria products page.</p>

<ul>
@foreach(string product in products)
{
    <li>product</li>
}
</ul>
@if (products.Length > 0)
{
    <p>We have products.</p>
}
else
{
    <p>We don't have products.</p>
}
@if (products.Length >= 3)
{
    <p>We have enough Products.</p>
}
else
{
    <p>We need more Products.</p>
}
<p>New Product: @newProduct</p>
<p>Product Category: @category</p>

@section Scripts {
    <script>
        alert("Welcome to the proudact Page!");
    </script>
}
