<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <title>@ViewBag.Title</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>
    <header>
        <h1>University Cafeteria</h1>
    </header>
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

        <a class="navbar-brand"
           asp-controller="Supply"
           asp-action="Index">
            University Cafeteria
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Supply" asp-action="Index">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Supply" asp-action="Products">Products</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Supply" asp-action="Suppliers">Suppliers</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Supply" asp-action="CreateRequest">Create Request</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Supply" asp-action="About">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Supply" asp-action="CheckQuantity">CheckQuantity</a>
                </li>

            </ul>
        </div>
    </div>
</nav>
    <main class="container my-4">
    @RenderBody()
</main>

    <footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">
        University Cafeteria - All Rights Reserved
    </p>
</footer>

    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
