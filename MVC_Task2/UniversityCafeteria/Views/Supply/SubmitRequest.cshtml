<div class="container mt-4">

    <h2>Supply Request Result</h2>

    <div class="alert alert-@ViewBag.MessageType">
        @ViewBag.Message
    </div>

    @if (ViewBag.MessageType == "success")
    {
        <h4>Request Details</h4>

        <ul class="list-group">
            <li class="list-group-item">
                Employee Name: @ViewBag.EmployeeName
            </li>

            <li class="list-group-item">
                Product Name: @ViewBag.ProductName
            </li>

            <li class="list-group-item">
                Quantity: @ViewBag.Quantity
            </li>

            <li class="list-group-item">
                Required Date: @ViewBag.RequiredDate
            </li>
        </ul>
    }

    <a href="/Supply/CreateRequest" class="btn btn-primary mt-3">
        Create Another Request
    </a>

</div>