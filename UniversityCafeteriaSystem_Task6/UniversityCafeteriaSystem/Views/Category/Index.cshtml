
@model List<UniversityCafeteriaSystem.Models.Category>
<a href="@Url.Action("Create", "Category")">Go To Create</a>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Action Edit</th>
            <th>Action Details</th>
             <th>Action Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td> <a href="@Url.Action("Edit","category",new{id=item.Id})">Edit</a></td>
                 <td> <a href="@Url.Action("Details","category",new{id=item.Id})">Details</a></td>
                 <td>
            <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@item.Id" />

                        <button type="submit"
                                onclick="return confirm('Are you sure you want to delete this category?')">
                            Delete
                      </button>
            </form>
                 </td>
            </tr>
        }
    </tbody>
    </table>