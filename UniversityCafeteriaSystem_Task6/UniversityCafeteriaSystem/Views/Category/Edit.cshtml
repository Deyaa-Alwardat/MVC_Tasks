@model UniversityCafeteriaSystem.Models.Category

<h2>Edit Category</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Description</label>
        <input asp-for="Description" />
    </div>

    <button type="submit">Save Changes</button>

</form>