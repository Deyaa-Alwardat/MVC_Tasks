@model List<UniversityCafeteriaSystem.Models.Product>
<a href="@Url.Action("Create", "Product")">Go To Create</a>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Actions Eidet </th>
            <th>Actions Delete </th>
            <th>Actions Details </th>

            

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td> <a href="@Url.Action("Edit","Product",new{id=item.Id})">Edit</a></td>
                 <td> <a href="@Url.Action("Details","Product",new{id=item.Id})">Details</a></td>
                 <td>
            <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@item.Id" />

                        <button type="submit"
                                onclick="return confirm('Are you sure you want to delete this category?')">
                            Delete
                      </button>
            </form>
                 </td>
            </tr>
        }
    </tbody>
</table>