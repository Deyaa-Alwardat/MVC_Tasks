@model UniversityCafeteriaSystem.Models.Product

<h2>Create Product</h2>

@using (Html.BeginForm())
{
    @Html.LabelFor(m => m.Name, "Product Name:")
    @Html.TextBoxFor(m => m.Name)
    <br />

    @Html.LabelFor(m => m.Description, "Product Description:")
    @Html.TextBoxFor(m => m.Description)
    <br />

    @Html.LabelFor(m => m.Price, "Product Price:")
    @Html.TextBoxFor(m => m.Price)
    <br />

    @Html.LabelFor(m => m.Quantity, "Product Quantity:")
    @Html.TextBoxFor(m => m.Quantity)
    <br />

    @Html.LabelFor(m => m.CategoryId, "Category Id:")
    @Html.TextBoxFor(m => m.CategoryId)
    <br />

    @Html.LabelFor(m => m.SupplierId, "Supplier Id:")
    @Html.TextBoxFor(m => m.SupplierId)
    <br />

    <button type="submit">Save</button>
}