
@model List<UniversityCafeteriaSystem.Models.Employee>

<a href="@Url.Action("Create", "Employee")">Go To Create</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Position</th>
            <th>Salary</th>
            <th>Hire Date</th>
            <th>Number Of Orders</th>
            <th>Actions Edit</th>
            <th>Actions Details</th>
            <th>Actions Delete</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Position</td>
                <td>@item.Salary</td>
                <td>@item.HireDate</td>
                <td>@item.Orders.Count</td>

                <td>
                    <a href="@Url.Action("Edit", "Employee", new { id = item.Id })">Edit</a>
                </td>

                <td>
                    <a href="@Url.Action("Details", "Employee", new { id = item.Id })">Details</a>
                </td>

                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@item.Id" />

                        <button type="submit"
                                onclick="return confirm('Are you sure you want to delete this employee?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
