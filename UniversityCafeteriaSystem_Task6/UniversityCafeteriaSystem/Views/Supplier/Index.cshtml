@model List<UniversityCafeteriaSystem.Models.Supplier>

<a href="@Url.Action("Create", "Supplier")">Go To Create</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Actions Edit</th>
            <th>Actions Details</th>
            <th>Actions Delete</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Address</td>

                <td>
                    <a href="@Url.Action("Edit", "Supplier", new { id = item.Id })">
                        Edit
                    </a>
                </td>

                <td>
                    <a href="@Url.Action("Details", "Supplier", new { id = item.Id })">
                        Details
                    </a>
                </td>

                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@item.Id" />

                        <button type="submit"
                                onclick="return confirm('Are you sure you want to delete this supplier?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>