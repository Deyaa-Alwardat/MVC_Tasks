@model UniversityCafeteriaSystem.Models.Supplier

<h2>Create Supplier</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Phone</label>
        <input asp-for="Phone" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Address</label>
        <input asp-for="Address" />
    </div>

    <button type="submit">Save</button>

</form>

<a asp-action="Index">Back to List</a>