<h2>Add Role</h2>

<form asp-controller="Role" asp-action="AddRole" method="post">

    <div class="mb-3">
        <label>Role Name</label>
        <input type="text" name="roleName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Add Role
    </button>

</form>