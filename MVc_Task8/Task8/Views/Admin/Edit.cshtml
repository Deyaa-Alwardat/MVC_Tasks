@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    var roles = ViewBag.Roles
        as List<Microsoft.AspNetCore.Identity.IdentityRole>;
}

<h2>Edit User Role</h2>

<p><strong>Email:</strong> @Model.Email</p>

<form asp-action="Edit" method="post">

    <input type="hidden"
           name="id"
           value="@Model.Id" />

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label>Select New Role</label>

        <select name="roleName" class="form-control">

            @foreach (var role in roles)
            {
                if (role.Name == (string)ViewBag.SelectedRole)
                {
                    <option value="@role.Name" selected>
                        @role.Name
                    </option>
                }
                else
                {
                    <option value="@role.Name">
                        @role.Name
                    </option>
                }
            }

        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>
