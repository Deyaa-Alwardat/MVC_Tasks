@model List<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    var userRoles = ViewBag.UserRoles
        as Dictionary<string, string>;
}

<h2>Manage Users</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>@userRoles[user.Id]</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-warning">
                        Edit Role
                    </a>

                    <form asp-action="Delete"
                          method="post"
                          style="display:inline">

                        <input type="hidden"
                               name="id"
                               value="@user.Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
