@model List<UniversityCafeteriaSupply.Models.SupplyRequestItem>
@{
    ViewData["Title"] = "Create Supply Request";
    
}
@if(ViewBag.Errors != null)
{
   <ul style="color:red">
        @foreach(var error in  ViewBag.Errors)
        {
             <li>@error</li>
        }
    </ul>
}
<h1>Create Supply Request</h1>
@if (TempData["PreferenceMessage"] != null)
{
    <p style="color:green">
        @TempData["PreferenceMessage"]
    </p>
}
<form method="post" action="@Url.Action("AddItem", "SupplyRequest")">
 <div>
     <label>Product Name</label>
     <input type="text" name="ProductName" required/>
 </div>
  <div>
     <label>Category</label>
     <input type="text" name="Category" required/> 
 </div>
  <div>
        <label>Quantity</label>
        <input type="number" name="Quantity" min="1" required />
    </div>

    <div>
        <label>Unit Price</label>
        <input type="number" name="UnitPrice" step="0.01" min="0.01" required />
    </div>
    <div>
        <label>Priority</label>
        <select name="Priority">

            <option value="Normal"
                    selected="@(ViewBag.PreferredPriority == "Normal" ? "selected" : null)">
                Normal
            </option>

            <option value="Urgent"
                    selected="@(ViewBag.PreferredPriority == "Urgent" ? "selected" : null)">
                Urgent
            </option>

            <option value="Emergency"
                    selected="@(ViewBag.PreferredPriority == "Emergency" ? "selected" : null)">
                Emergency
            </option>

        </select>
    </div>

    <button type="submit">Add Product</button>
</form>

<hr />

<h3>Added Products</h3>

@if (Model.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Priority</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductName</td>
                    <td>@product.Category</td>
                    <td>@product.Quantity</td>
                    <td>@product.UnitPrice</td>
                    <td>@product.Priority</td>
                    <td>@product.Total</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products added yet.</p>
}
<a href="@Url.Action("Review", "SupplyRequest")">
    Review Request
</a>
<form method="post" action="@Url.Action("ClearDraft", "SupplyRequest")">

    <button type="submit" class="btn btn-danger">
        Clear Draft
    </button>

</form>
<hr />

<h3>Save Preferred Priority</h3>

<form method="post" action="@Url.Action("SavePreference", "SupplyRequest")">

    <div>
        <label>Choose Your Preferred Priority</label>

        <select name="priority">
            <option value="Normal">Normal</option>
            <option value="Urgent">Urgent</option>
            <option value="Emergency">Emergency</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Preference
    </button>

</form>