@model List<UniversityCafeteriaSupply.Models.ConfirmedSupplyRequest>

@{
    ViewData["Title"] = "My Requests";
}

<h2>My Confirmed Requests</h2>

@if (Model.Count > 0)
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Request ID</th>
                <th>Number of Products</th>
                <th>Subtotal</th>
                <th>Preparation Fee</th>
                <th>Discount</th>
                <th>Final Total</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.RequestId</td>
                    <td>@request.Products.Count</td>
                    <td>@request.Subtotal JD</td>
                    <td>@request.PreparationFee JD</td>
                    <td>@request.Discount JD</td>
                    <td>@request.FinalTotal JD</td>
                    <td>@request.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No confirmed requests yet.</p>
}