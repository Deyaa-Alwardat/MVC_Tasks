@{
    ViewData["Title"] = "Review Request";
}



<h2>Supply Request Review</h2>

<h3>Products</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Priority</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in ViewBag.Products)
        {
            <tr>
                <td>@product.ProductName</td>
                <td>@product.Category</td>
                <td>@product.Quantity</td>
                <td>@product.UnitPrice JD</td>
                <td>@product.Priority</td>
                <td>@product.Total JD</td>
            </tr>
        }
    </tbody>
</table>
<hr />

<h3>Subtotal: @ViewBag.Subtotal JD</h3>

<h3>Preparation Fee: @ViewBag.PreparationFee JD</h3>

<h3>Discount: @ViewBag.Discount JD</h3>
<hr />

<h2>Final Total: @ViewBag.FinalTotal JD</h2>

<form method="post" action="@Url.Action("ConfirmRequest", "SupplyRequest")">

    <button type="submit" class="btn btn-success">
        Confirm Request
    </button>

</form>