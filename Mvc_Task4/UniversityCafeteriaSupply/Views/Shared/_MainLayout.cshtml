<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - University Cafeteria</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand"
               href="@Url.Action("Index", "SupplyRequest")">
                University Cafeteria
            </a>

            <div class="navbar-nav">

                <a class="nav-link"
                   href="@Url.Action("Index", "Home")">Home</a>


                <a class="nav-link"
                   href="@Url.Action("Index", "SupplyRequest")">Create Supply Request</a>

                <a class="nav-link"
                   href="@Url.Action("Review", "SupplyRequest")">Review Draft</a>

                <a class="nav-link"
                   href="@Url.Action("MyRequests", "SupplyRequest")">My Requests</a>

                <a class="nav-link"
                   href="@Url.Action("About", "SupplyRequest")">About</a>

            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>